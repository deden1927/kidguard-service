    <string name="overlay_lock_pin_hint">Masukkan PIN Orang Tua</string>
    <string name="overlay_lock_btn_unlock">Buka Kunci dengan PIN</string>

    <string name="overlay_msg_header">Pesan dari Orang Tua</string>
    <string name="overlay_msg_ack_button">Saya Sudah Membaca Pesan Ini</string>
