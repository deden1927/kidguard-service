<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/screen_vertical_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/header_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_size" />

            <Button
                android:id="@+id/btnToggleTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_secondary_button"
                android:focusable="true"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/btn_toggle_theme_light"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPinGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pin_gate_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_section_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pin_gate_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_size" />

            <TextView
                android:id="@+id/labelPinGateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etPinGateInput"
                android:text="@string/pin_gate_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_size"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPinGateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/pin_gate_hint"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:minHeight="@dimen/min_touch_target"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body_size" />

            <TextView
                android:id="@+id/tvPinGateError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_danger"
                android:padding="10dp"
                android:textColor="@color/status_danger_text"
                android:textSize="@dimen/text_body_size"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUnlockPinGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_primary_button"
                android:focusable="true"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/pin_gate_submit"
                android:textAllCaps="false"
                android:textColor="@color/accent_on_primary"
                android:textSize="@dimen/text_body_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutParentPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_bot_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_section_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/section_bot_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvServiceRunningBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_status_danger"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="[LAYANAN BELUM BERJALAN]"
                    android:textColor="@color/status_danger_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/etBotToken"
                    android:text="@string/label_bot_token"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBotToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_bot_token"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:minHeight="@dimen/min_touch_target"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/etParentChatId"
                    android:text="@string/label_chat_id"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etParentChatId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_chat_id"
                    android:importantForAutofill="no"
                    android:inputType="numberSigned"
                    android:minHeight="@dimen/min_touch_target"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/etParentPin"
                    android:text="@string/label_parent_pin"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etParentPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_parent_pin"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:minHeight="@dimen/min_touch_target"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_body_size" />

                <LinearLayout
                    android:id="@+id/layoutConnectionState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ProgressBar
                        android:id="@+id/pbConnectionLoading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvConnectionState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/conn_state_empty"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveAndStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_primary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:padding="12dp"
                    android:text="@string/btn_save_and_start"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_on_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTestTelegram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_gap"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:padding="12dp"
                    android:text="@string/btn_test_telegram"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <Button
                    android:id="@+id/btnStopService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_gap"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:padding="12dp"
                    android:text="@string/btn_stop_service"
                    android:textAllCaps="false"
                    android:textColor="@color/status_danger_text"
                    android:textSize="@dimen/text_body_size" />

                <Button
                    android:id="@+id/btnLockPanelNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_gap"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:padding="12dp"
                    android:text="@string/btn_lock_panel"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_permissions_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_section_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/section_permissions_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermAccessibilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_accessibility_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_accessibility_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_accessibility"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermUsageStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_usage_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_usage_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_usage"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermLocationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_location_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_location_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_location"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermOverlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_overlay_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_overlay_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_overlay"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermBatteryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_battery_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_battery_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_battery"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermAdminStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_admin_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_admin_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_admin"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvPermNotifStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/perm_notif_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/perm_notif_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPermNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_perm_notif"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_history_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_section_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/section_history_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_size" />

                <TextView
                    android:id="@+id/tvHistoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:text="@string/history_state_empty"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <Button
                    android:id="@+id/btnRefreshHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_refresh_history"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_size" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_gap"
                    android:background="@drawable/bg_secondary_button"
                    android:focusable="true"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/btn_clear_history"
                    android:textAllCaps="false"
                    android:textColor="@color/status_danger_text"
                    android:textSize="@dimen/text_body_size" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
